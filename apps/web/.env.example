# SAFE DEFAULT: no database, credentials, real requests, or AI inference.
VITE_DATA_MODE=mock
# Only enable real API mode in a separately reviewed production build.
# VITE_DATA_MODE=api
# VITE_API_BASE_URL=https://api.your-host.example/api/v1

# Keep demo controls browser-local unless a protected same-origin PHP JSON API is deployed.
# VITE_MODULE_CONTROL_MODE=api
# VITE_MODULE_API_BASE_URL=/krishigo/api/v1

# M12: optional isolated JSON pilot only (not part of default DigiOps bundle).
# VITE_JSON_WORKFLOWS_MODE=api
# VITE_JSON_API_BASE_URL=/krishigo/api/v1
