# Staging session demo: OFF unless explicitly enabled. Do not commit real hashes/passwords.
KRISHIGO_STAGE_AUTH=disabled
KRISHIGO_STAGE_USERNAME=
# Generate locally: php -r 'echo password_hash("your-long-random-password", PASSWORD_DEFAULT), PHP_EOL;'
KRISHIGO_STAGE_PASSWORD_HASH=
KRISHIGO_STAGE_ROLE=farmer
# Allow local HTTP only for loopback tests. Not for public staging.
KRISHIGO_ALLOW_HTTP_LOCAL=0
# Set only to exact authenticated reverse proxy addresses after validating hosting topology.
KRISHIGO_TRUSTED_PROXY_IPS=
