# Staging session demo: OFF unless explicitly enabled. Do not commit real hashes/passwords.
KRISHIGO_STAGE_AUTH=disabled
KRISHIGO_STAGE_USERNAME=
# Generate locally: php -r 'echo password_hash("your-long-random-password", PASSWORD_DEFAULT), PHP_EOL;'
KRISHIGO_STAGE_PASSWORD_HASH=
KRISHIGO_STAGE_ROLE=farmer
# Allow local HTTP only for loopback tests. Not for public staging.
KRISHIGO_ALLOW_HTTP_LOCAL=0
# Set only to exact authenticated reverse proxy addresses after validating hosting topology.
KRISHIGO_TRUSTED_PROXY_IPS=

# Production is EXPLICIT and never used for database-free DigiOps staging builds.
# Provision an isolated MySQL database, apply migrations after backup, set PHP variables
# in a private hosting configuration. No production .env or secrets in Git.
KRISHIGO_API_MODE=staging
KRISHIGO_DB_DSN=
KRISHIGO_DB_USER=
KRISHIGO_DB_PASSWORD=
# Use a long random secret for HMAC-throttling keys. Keep stable across PHP workers.
KRISHIGO_RATE_SALT=
# CLI bootstrap only (remove immediately after creating first admin).
KRISHIGO_BOOTSTRAP_ADMIN_EMAIL=
KRISHIGO_BOOTSTRAP_ADMIN_NAME=
KRISHIGO_BOOTSTRAP_ADMIN_PASSWORD=
